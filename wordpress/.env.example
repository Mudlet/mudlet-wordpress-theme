# Copy to .env and edit if the defaults clash with something you already run.
# Every value here has a default in docker-compose.yml; this file only exists so
# you can change one without editing the compose file.

SITE_PORT=8080
SITE_URL=http://localhost:8080
SITE_TITLE=Mudlet
SITE_TAGLINE=A cross-platform, open source, and super fast MUD client with scripting in Lua.

# The seed script creates this account. Local only - do not reuse a real one.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

DB_NAME=mudlet
DB_USER=mudlet
DB_PASSWORD=mudlet
DB_ROOT_PASSWORD=root

WP_DEBUG=1

# Install Polylang and create the five languages. Set to 0 for a plain
# single-language install.
SEED_LANGUAGES=1

# Write a handful of placeholder news posts when no WXR export is present, so
# the archive and single-post templates have something to render. Ignored once
# seed/wxr/ contains an export.
SEED_DEMO_POSTS=1

# Fetch the images a WXR export references. Off by default: the export carries
# URLs, not files, so this means 178 posts' worth of requests at the live site.
IMPORT_MEDIA=0
