node_modules/
demo/dist/
# generated by demo/scripts/build-package.mjs
demo/src/assets/*.mpackage
demo/src/assets/mudlet-demo.version.ts
.idea/

# Scraped copy of the live mudlet.org, kept for recon only — nothing builds
# from it. The images the theme actually uses are in its own assets/img/.
reference/

# local WordPress stack
wordpress/.env
# the news export you drop in from the live site — not ours to redistribute
wordpress/seed/wxr/*.xml
# bind-mount target for demo/dist; docker creates it
wordpress/theme/mudlet/assets/demo/
# same, for the three plugins the theme carries: compose mounts
# wordpress/plugin/* in here so the stack runs what the zip ships
wordpress/theme/mudlet/plugins/

# built by wordpress/tools/build-dist.mjs, for uploading to a test site
wordpress/dist/
# raw wp-admin exports: carry Contact Form 7 submissions (personal data).
# Filter with tools/filter-wxr.js; only the filtered file goes to seed/wxr/.
wordpress/seed/export/

# Generated release dump (node wordpress/tools/fetch-releases.mjs).
# Derived data that goes stale with every release; regenerate rather than commit.
wordpress/seed/releases.json
